{
  "name": "dsh-unlimited-retry",
  "version": "2.2.0",
  "description": "Unbounded model-request retry for the DeepSeek Harness agent loop, with a live Settings panel.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "retry",
    "backoff",
    "resilience"
  ],
  "license": "MIT",
  "author": "xalor888 <xalor888@users.noreply.github.com>",
  "homepage": "https://github.com/xalor888/dsh-unlimited-retry#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xalor888/dsh-unlimited-retry.git"
  },
  "bugs": {
    "url": "https://github.com/xalor888/dsh-unlimited-retry/issues"
  },
  "icon": "./icon.svg",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
